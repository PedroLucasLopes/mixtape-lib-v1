{
  "name": "@pedrolucaslopes/mixtape-ui",
  "version": "0.5.0",
  "type": "module",
  "description": "Componentes Vue e Vuetify, tema, movimento e Storybook do Mixtape.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroLucasLopes/mixtape-lib-v1.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/icons.generated.d.ts",
      "import": "./dist/icons/icons.generated.js"
    },
    "./styles": "./dist/styles/base.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6010",
    "build-storybook": "storybook build",
    "build": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "check:contrast": "node scripts/check-contrast.mjs",
    "sync:brand-icons": "node scripts/sync-brand-icons.mjs",
    "sync:icons": "node scripts/sync-icons.mjs",
    "check:icons": "node scripts/sync-icons.mjs --check",
    "check:locales": "node scripts/check-locales.mjs src/i18n/locales --reference=pt-BR.json --sources=src",
    "prepublishOnly": "npm run check:icons && npm run check:locales && npm run check:contrast && npm run type-check && npm run test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vuetify": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vue-i18n": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "simple-icons": "^16.34.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-tsc": "^3.3.12",
    "vuetify": "^4.2.4"
  }
}
